#!/bin/sh
# The Longshot AppImage: the Linux builder, for the command line. Its Python, Longshot's sources and nx2/make_game.py (the
# player's build compiles the Vulkan back end from them too). It has no window: players use the Longshot Launcher, which
# unpacks this AppImage and runs make_game.py with its Python. The build tools (clang and lld, a glibc 2.35 sysroot, FFmpeg, SDL2, the Vulkan headers) are
# tools.lock's linux-x64 lines, outside the image: builder/linux/linux_tools.py finds them (the Longshot Launcher's, or the
# builder's own toolchains folder) and, for --cli, downloads what is missing.
#   Longshot.AppImage --cli <args>     nx2/make_game.py itself, e.g. --cli --nup game.nup --out ~/Games/Longshot
#                                      (RecompLauncher's prepare: --cli --prepare --game <copy>)
#   Longshot.AppImage --play           start the game in ~/Games/Longshot
#   Longshot.AppImage --play <folder>  start the game in that folder (RecompLauncher's start)
#   Longshot.AppImage <folder>         the same
#   Longshot.AppImage --launch <dir>  the same (a game folder's longshot, builder/linux/longshot-folder, when --cli built it)
#   Longshot.AppImage                  a message: get the Longshot Launcher
#   Longshot.AppImage [--setup]        (ARM64 setup AppImage) the setup window, builder/linux/setup_ui
HERE="$(dirname "$(readlink -f "$0")")"
# (arm64 port) Steam's overlay libraries, those for this CPU only (as builder/linux/longshot-launch for the game): Steam
# preloads its x86 ones too, and the loader says "ERROR: ld.so: ... cannot be preloaded" for each in every program it starts
preloads_for_this_cpu() {
    [ -n "${LD_PRELOAD:-}" ] || return 0
    want=$(LD_PRELOAD= od -An -tx1 -j18 -N2 /bin/sh 2>/dev/null | LD_PRELOAD= tr -d ' \n')
    kept=
    old_ifs=$IFS
    IFS=': '
    for lib in $LD_PRELOAD; do
        case $lib in
            *'$'*) kept=${kept:+$kept:}$lib ;;
            *) if [ -f "$lib" ] && [ "$(LD_PRELOAD= od -An -tx1 -j18 -N2 "$lib" 2>/dev/null | LD_PRELOAD= tr -d ' \n')" = "$want" ]; then
                   kept=${kept:+$kept:}$lib
               fi ;;
        esac
    done
    IFS=$old_ifs
    if [ -n "$kept" ]; then export LD_PRELOAD="$kept"; else unset LD_PRELOAD; fi
}
preloads_for_this_cpu
export LONGSHOT_TOOLS="$HERE/usr/share/longshot"
# (written into the game folder's longshot_version.txt, so its launcher finds this builder)
if [ -n "${APPIMAGE:-}" ]; then
    export LONGSHOT_BUILDER_EXE="$APPIMAGE"
else
    export LONGSHOT_BUILDER_EXE="$HERE/AppRun"
fi
PY="$HERE/usr/python/bin/python3"
# (ARM64 Linux: the CPU level the game is built for, until nx2/host_cpu.py knows ARM's: docs/arm64-port-plan.md. The setup
# AppImage's third-party objects were made at it, so a player's build takes them)
case "$(uname -m)" in aarch64) export RX_MARCH="${RX_MARCH:-armv8.2-a+lse+rcpc+dotprod}" ;; esac
# The build tools' places (EMSDK, LONGSHOT_SYSROOT, LONGSHOT_FFMPEG, LONGSHOT_SDL2, RX_CPM), each downloaded first when it is
# missing, its progress on stderr. A tool that cannot be had stops --cli
build_tools() {
    tools_env=$("$PY" -I "$LONGSHOT_TOOLS/builder/linux/linux_tools.py" env --install) && tools_ok=1 || tools_ok=
    eval "$tools_env"
    [ -n "$tools_ok" ]
}
# (arm64 port) A build's log goes next to the AppImage, in Longshot-logs/build-<date>-<time>.log: in Game Mode there is no
# terminal to read it in, and the setup window shows its path. Where that folder can't be written (a read-only medium):
# $XDG_STATE_HOME/longshot/logs. Only for the AppImage itself ($APPIMAGE): RecompLauncher unpacks it and keeps its own log
log_dir() {
    for d in "$(dirname "$APPIMAGE")/Longshot-logs" "${XDG_STATE_HOME:-$HOME/.local/state}/longshot/logs"; do
        if mkdir -p "$d" 2>/dev/null && [ -w "$d" ]; then
            printf '%s\n' "$d"
            return 0
        fi
    done
    return 1
}
if [ -n "${APPIMAGE:-}" ] && [ -z "${LONGSHOT_LOG_DIR:-}" ]; then
    LONGSHOT_LOG_DIR=$(log_dir) || LONGSHOT_LOG_DIR=
    export LONGSHOT_LOG_DIR
fi
if [ "${1:-}" = "--cli" ]; then
    shift
    # (arm64 port) Not Steam's overlay, which Steam preloads into what it starts (the setup window, and the build it runs):
    # its x86 libraries cannot load into ARM64 programs, and the loader said so twice for every one the build started
    unset LD_PRELOAD
    build_tools || exit 1
    has_log=
    for arg in "$@"; do
        case $arg in --log|--log=*) has_log=1 ;; esac
    done
    if [ -z "$has_log" ] && [ -n "${LONGSHOT_LOG_DIR:-}" ]; then
        log="$LONGSHOT_LOG_DIR/build-$(date +%Y%m%d-%H%M%S).log"
        echo "Longshot: this build's log is $log" >&2
        set -- "$@" --log "$log"
    fi
    exec "$PY" -I "$LONGSHOT_TOOLS/nx2/make_game.py" "$@"
fi
# Play is the same AppImage: the start script drops this image's libraries, then runs the built game. It needs no build tool.
if [ "${1:-}" = "--play" ]; then
    shift
    exec "$LONGSHOT_TOOLS/builder/linux/longshot-launch" "$@"
fi
if [ "${1:-}" = "--launch" ] && [ -n "${2:-}" ] && [ -d "$2" ]; then
    exec "$LONGSHOT_TOOLS/builder/linux/longshot-launch" "$2"
fi
if [ -n "${1:-}" ] && [ -d "$1" ]; then
    exec "$LONGSHOT_TOOLS/builder/linux/longshot-launch" "$1"
fi
# (arm64 port) The setup window (builder/linux/setup_ui, in the ARM64 setup AppImage): the game file, the game folder, the build
# with its log and progress, and Add to Steam, for Game Mode and its controller. Started with no arguments, or --setup, when
# there is a display; it runs this file's --cli for the build
UI="$HERE/usr/bin/longshot-setup"
if [ -x "$UI" ] && { [ $# -eq 0 ] || [ "${1:-}" = "--setup" ]; } && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    export LONGSHOT_APPRUN="$HERE/AppRun"
    # Its own log: setup-window.log in the logs folder (the last run's kept as setup-window.prev.log). Started where nobody
    # reads its output (Steam, Game Mode), all of it goes there, the loader's and the libraries' messages too; from a
    # terminal the window copies its output there itself
    if [ -n "${LONGSHOT_LOG_DIR:-}" ]; then
        export LONGSHOT_SETUP_LOG="$LONGSHOT_LOG_DIR/setup-window.log"
        [ ! -f "$LONGSHOT_SETUP_LOG" ] || mv -f "$LONGSHOT_SETUP_LOG" "$LONGSHOT_LOG_DIR/setup-window.prev.log" 2>/dev/null || true
        echo "== $(date '+%Y-%m-%d %H:%M:%S') AppRun: the setup window ($(uname -m), DISPLAY=${DISPLAY:-}," \
             "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-})" >> "$LONGSHOT_SETUP_LOG" 2>/dev/null || true
        if [ ! -t 2 ]; then
            export LONGSHOT_SETUP_LOGGED=1
            exec "$UI" >> "$LONGSHOT_SETUP_LOG" 2>&1
        fi
    fi
    exec "$UI"
fi
if [ -x "$UI" ]; then
    echo "The Longshot setup window needs a display. On the command line: $(basename "${APPIMAGE:-$0}") --cli --nup <game.nup> --out <folder>" >&2
    exit 1
fi
# Anything else (started from the applications menu or a file manager): no window, a message
MESSAGE="The Longshot Builder has no window of its own: the Longshot Launcher builds the game and starts it. Get the launcher from https://longshot.magicbean.dev/download"
echo "$MESSAGE" >&2
if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && [ ! -t 2 ]; then
    if command -v zenity >/dev/null 2>&1; then
        zenity --info --title="Longshot Builder" --text="$MESSAGE" >/dev/null 2>&1 || true
    elif command -v kdialog >/dev/null 2>&1; then
        kdialog --title "Longshot Builder" --msgbox "$MESSAGE" >/dev/null 2>&1 || true
    fi
fi
exit 1
