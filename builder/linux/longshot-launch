#!/bin/sh
# Start a built game from its folder, without the AppImage's libraries.
# The builder AppImage calls this for --play, --launch <folder> and <folder>.
#
#   longshot-launch                      ~/Games/Longshot, the folder a build goes to by default
#   longshot-launch /path/to/the/game    that folder
set -eu

folder=${1:-$HOME/Games/Longshot}

if ! [ -f "$folder/image.bin" ] || ! [ -x "$folder/bin/longshot" ]; then
    echo "Longshot: no built game to start in $folder. Build one with the Longshot Launcher, or pass its folder." >&2
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && [ ! -t 2 ]; then
        if command -v zenity >/dev/null 2>&1; then
            zenity --error --title=Longshot --text="No built game to start. Build one with the Longshot Launcher first." || true
        elif command -v kdialog >/dev/null 2>&1; then
            kdialog --error "No built game to start. Build one with the Longshot Launcher first." || true
        fi
    fi
    exit 1
fi

# The AppImage runtime and the builder put their own libraries on the search path. The game loads
# SDL from beside itself, so those names go before it starts. The same set as make_game.GAME_ENV_DROP.
# (RX_MARCH and RX_CPM: the build's, which the game takes for misspelt switches of its own)
names=$(env | awk -F= '$1 ~ /^(LONGSHOT_|PYTHON|APPDIR|APPIMAGE|ARGV0|OWD|RX_MARCH|RX_CPM)/ || $1 == "LD_LIBRARY_PATH" { print $1 }')
for name in $names; do
    unset "$name"
done

# (arm64 port) Steam's overlay libraries, those for this CPU only: Steam preloads its x86 ones too, and the loader says
# "ERROR: ld.so: ... cannot be preloaded" for each in every program it starts. Steam's ARM64 one (steamrtarm64) stays.
# What CPU a library is for: its ELF header's machine, as /bin/sh's
preloads_for_this_cpu() {
    [ -n "${LD_PRELOAD:-}" ] || return 0
    want=$(LD_PRELOAD= od -An -tx1 -j18 -N2 /bin/sh 2>/dev/null | LD_PRELOAD= tr -d ' \n')
    kept=
    old_ifs=$IFS
    IFS=': '
    for lib in $LD_PRELOAD; do
        case $lib in
            *'$'*) kept=${kept:+$kept:}$lib ;;   # ($LIB, $PLATFORM: the loader's to resolve)
            *) if [ -f "$lib" ] && [ "$(LD_PRELOAD= od -An -tx1 -j18 -N2 "$lib" 2>/dev/null | LD_PRELOAD= tr -d ' \n')" = "$want" ]; then
                   kept=${kept:+$kept:}$lib
               fi ;;
        esac
    done
    IFS=$old_ifs
    if [ -n "$kept" ]; then export LD_PRELOAD="$kept"; else unset LD_PRELOAD; fi
}
preloads_for_this_cpu

cd "$folder"
# (--play already chose Play. The game's own update question stays for a bin/longshot the player started themselves)
export LONGSHOT_NO_UPDATE_CHECK=1
# (arm64 port) Started by Steam or a desktop launcher, not from a terminal: the game writes its own log, logs/longshot_log.txt
# in its folder with the four runs before it, which it does when its stderr is no terminal, no pipe and no file
# (host/hos_main.c). Steam gives it a pipe, which nobody reads in Game Mode
[ -t 2 ] || exec 2>/dev/null
exec ./bin/longshot
